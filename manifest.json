{
  "id": "grocery",
  "name": "Grocery List",
  "version": "1.3.1",
  "description": "A shared household grocery list. Any member can add items and check them off. Items are alphabetical and automatically deduplicated.",
  "entrypoint": "index.html",
  "runtime": "static",
  "storage": "db",
  "db_encryption": "off",
  "category": "family",
  "tags": [
    "grocery",
    "shopping",
    "list",
    "household"
  ],
  "nav": {
    "label": "Groceries"
  },
  "widget": {
    "label": "Groceries",
    "size": "small"
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_grocery__items WHERE checked = 0 LIMIT 1"
    },
    "display": { "template": "badge", "count": "n", "label": "to buy", "severity": "info" }
  },
  "capture_consumer": { "kinds": ["grocery_item"], "via": "quick_add" },
  "kiosk_quick_add": {
    "table": "items",
    "label": "Grocery list",
    "text_column": "name",
    "normalized_column": "name_normalized",
    "actions": ["add", "toggle"],
    "done_column": "checked",
    "done_by_name_column": "checked_by_name",
    "attribution": { "id_column": "added_by_id", "name_column": "added_by_name" },
    "created_at_column": "created_at"
  },
  "member_references": {
    "items": {
      "column": "added_by_id",
      "on_removed": "keep"
    }
  },
  "db_plaintext_columns": ["checked"],
  "retention": {
    "items": {
      "default": 60,
      "timestamp_column": "created_at",
      "override_key": "checked_items",
      "exempt_when": {
        "column": "checked",
        "values": [0]
      }
    }
  },
  "exports": ["pending_items"],
  "contexts": ["household", "shared_space"],
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "resource_limits": {
    "max_db_bytes": 52428800,
    "max_store_bytes": 262144,
    "max_store_reads_per_day": 1000,
    "max_store_writes_per_day": 500
  },
  "icon": "🛒",
  "ai_access": {
    "allowed": true,
    "mode": "read_write",
    "db_exports": ["pending_items", "all_items"],
    "db_mutations": ["check_off_item", "uncheck_item"],
    "db_inserts": ["add_item"]
  }
}
